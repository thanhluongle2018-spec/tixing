{
  "name": "tixing",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r --filter @tixing/shared --filter @tixing/db --filter @tixing/core --filter @tixing/api --filter @tixing/worker --filter @tixing/web build",
    "dev:api": "pnpm --filter @tixing/api dev",
    "dev:worker": "pnpm --filter @tixing/worker dev",
    "dev:web": "pnpm --filter @tixing/web dev",
    "test": "pnpm --filter @tixing/core test",
    "db:generate": "pnpm --filter @tixing/db generate",
    "db:migrate": "pnpm --filter @tixing/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @tixing/db migrate:dev",
    "lint": "pnpm -r --if-present lint"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
